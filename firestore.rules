rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      // Anyone can browse the storefront; only signed-in admins can
      // create, edit, or delete products.
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /orders/{orderId} {
      // Orders are created only by api/order.js (Admin SDK, which bypasses
      // these rules) after the bot and fake-lead checks. Browsers can't
      // create them directly, so the checks can't be skipped.
      allow create: if false;
      allow read, update, delete: if request.auth != null;
    }
  }
}
